<?php

declare(strict_types=1);

// A stand-in for moselwal/secret-resolver's two classes typo3-config uses.
// Loaded only by tests that run in their own process. Neither .php nor .inc:
// composer scans both and refuses these namespaces under tests/ (psr-4).

namespace Moselwal\SecretResolver\Domain\ValueObject {
    final class SecretKey
    {
        public function __construct(public string $raw)
        {
            if (preg_match('/^[A-Z0-9_]+$/', $raw) !== 1) {
                throw new \InvalidArgumentException('invalid key');
            }
        }
    }
}

namespace Moselwal\SecretResolver\Infrastructure\Factory {
    use Moselwal\SecretResolver\Domain\ValueObject\SecretKey;

    final class BuiltInSecretResolver
    {
        /** @var array<string, string> */
        public static array $values = [];

        public static function create(): object
        {
            return new class () {
                public function resolve(SecretKey $key): ?string
                {
                    return BuiltInSecretResolver::$values[$key->raw] ?? null;
                }
            };
        }
    }
}
